{
  "name": "moneyflow-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for MoneyFlow - Finance, Sales & Warranty Management",
  "main": "src/server.ts",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
